# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: se usa únicamente para escribir la cache de BGG
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (redirecciones de OAuth y magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BoardGameGeek: si está definido se usa BggProvider
BGG_API_TOKEN=
# Opcional: "mock" fuerza MockProvider (por ejemplo, e2e contra un build de producción)
GAME_DATA_PROVIDER=
